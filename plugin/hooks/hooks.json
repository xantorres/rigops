{
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume|compact", "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rigops-hook.sh\" session-start", "timeout": 10}]}
