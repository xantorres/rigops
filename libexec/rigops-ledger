#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rigops import cli  # noqa: E402
from rigops import config as rigops_config  # noqa: E402
from rigops import fmt  # noqa: E402
from rigops import ledger_row  # noqa: E402
from rigops import levers  # noqa: E402
from rigops import state  # noqa: E402
from rigops.doctor import check_levers  # noqa: E402
from rigops.errors import RigopsError  # noqa: E402


def _rewrite_jsonl(path: Path, rows: list) -> None:
    text = "".join(json.dumps(r, separators=(",", ":")) + "\n" for r in rows)
    state.atomic_write(path, text)


def _load_ledger_rows(path: Path) -> list:
    rows = state.read_jsonl(path)
    for row in rows:
        if "date" not in row:
            raise RigopsError(f"ledger row missing 'date' in {path}")
    return rows


def _has_date(row: dict) -> bool:
    return isinstance(row.get("date"), str)


def _report_skipped(skipped: int, what: str) -> None:
    if skipped:
        print(f"warning: skipped {skipped} unreadable {what} row(s)", file=sys.stderr)


def _refuse_existing(at: dt.date) -> int:
    print(f"ledger {at}: row exists, nothing appended (use --force to replace)")
    return 0


def _warn_on_row_health(row: dict, at: dt.date) -> None:
    lost = ledger_row.unparsed(row)
    if lost:
        print(f"warning: {ledger_row.unparsed_text(*lost)}; this row may undercount",
              file=sys.stderr)
    if row.get("window_empty"):
        print(f"warning: no transcript turns in the {row['window']['days']} days before {at}; "
              "row written, marked empty", file=sys.stderr)


def cmd_write(args) -> int:
    cfg = rigops_config.load()
    watch_projects = rigops_config.get(cfg, "ledger.watch_projects", {}) or {}
    jsonl_path = state.state_dir() / "ledger.jsonl"
    md_path = state.state_dir() / "ledger.md"

    if args.show:
        if args.json:
            shown, skipped = state.read_rows(jsonl_path, _has_date)
            _report_skipped(skipped, "ledger")
            print(json.dumps({"version": 1, "rows": shown, "skipped": skipped},
                             indent=2, default=str))
        else:
            sys.stdout.write(md_path.read_text() if md_path.exists() else "no ledger yet\n")
        return 0

    if args.at:
        try:
            at = dt.date.fromisoformat(args.at)
        except ValueError:
            print("error: --at must be YYYY-MM-DD", file=sys.stderr)
            return 2
    else:
        at = dt.date.today()
    rows = _load_ledger_rows(jsonl_path)
    existing = [r for r in rows if r.get("date") == at.isoformat()]

    if existing and not args.force and not args.dry_run:
        return _refuse_existing(at)

    if rigops_config.get(cfg, "sources.custom"):
        rigops_config.require_private(rigops_config.config_path())
    row = levers.build_row(at, args.label, cfg=cfg)
    _warn_on_row_health(row, at)
    prev = rows[-1] if rows else None
    base = rows[0] if rows else None

    if not args.dry_run:
        with state.locked(jsonl_path):
            # The scan takes minutes, so another writer may have landed this date meanwhile.
            rows = _load_ledger_rows(jsonl_path)
            if any(r.get("date") == at.isoformat() for r in rows):
                if not args.force:
                    return _refuse_existing(at)
                rows = [r for r in rows if r.get("date") != at.isoformat()] + [row]
                rows.sort(key=lambda r: r.get("date", ""))
                _rewrite_jsonl(jsonl_path, rows)
            else:
                rows.append(row)
                state.append_jsonl(jsonl_path, row)
            # ledger.md is fully regenerated from ledger.jsonl so column additions never
            # desync the table header from appended rows; jsonl stays the source of truth.
            state.atomic_write(md_path, levers.render_markdown(rows, watch_projects))

    if args.json:
        print(json.dumps({"version": 1, "row": row}, indent=2, default=str))
    else:
        suffix = "  (dry-run)" if args.dry_run else ""
        print(levers.summary_line(row, prev, base, watch_projects) + suffix)
    return 0


def cmd_note(args) -> int:
    text = args.text.strip()
    if not text:
        print("error: note text must not be blank", file=sys.stderr)
        return 2

    if args.at:
        try:
            at = dt.date.fromisoformat(args.at)
        except ValueError:
            print("error: --at must be YYYY-MM-DD", file=sys.stderr)
            return 2
    else:
        at = dt.date.today()

    ts = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
    entry = {"ts": ts, "date": at.isoformat(), "text": text}
    if args.accept:
        # A misspelt lever would record an acceptance that silences nothing.
        rules, _ = check_levers.effective_rules(rigops_config.load())
        unknown = sorted(set(args.accept) - set(rules))
        if unknown:
            known = ", ".join(sorted(rules)) or "none"
            print(
                f"error: no lever rule for {', '.join(unknown)} (judged: {known})",
                file=sys.stderr,
            )
            return 2
        entry["accept"] = sorted(set(args.accept))
    path = state.state_dir() / "interventions.jsonl"
    with state.locked(path):
        state.append_jsonl(path, entry)
    print(f"noted {at.isoformat()}: {text}{_accept_suffix(entry)}")
    return 0


def _accept_suffix(entry: dict) -> str:
    accepted = entry.get("accept")
    return f" (accepts {', '.join(accepted)})" if isinstance(accepted, list) and accepted else ""


def _interventions_between(baseline_date: str, latest_date: str) -> tuple:
    entries, skipped = state.read_rows(state.state_dir() / "interventions.jsonl", _has_date)
    window = [e for e in entries if baseline_date < e.get("date", "") <= latest_date]
    window.sort(key=lambda e: (e.get("date", ""), e.get("ts", "")))
    return window, skipped


DERIVE_GLOBS = ["**/CLAUDE.md", "**/AGENTS.md", "**/settings.json", "**/settings.local.json",
                "**/.mcp.json", "**/SKILL.md", "rules/**"]


def _git_log(repo: Path, since: str, globs: list) -> str | None:
    cmd = ["git", "-C", str(repo), "log", "--no-merges", f"--since={since} 00:00",
           "--date=format-local:%Y-%m-%d", "--format=%x1e%h%x1f%cd%x1f%s", "--name-only",
           "--", *(f":(glob){g}" for g in globs)]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"warning: derived interventions skipped for {repo}: {exc}", file=sys.stderr)
        return None
    if proc.returncode != 0:
        reason = (proc.stderr.strip().splitlines() or ["git log failed"])[0]
        print(f"warning: derived interventions skipped for {repo}: {reason}", file=sys.stderr)
        return None
    return proc.stdout


def _derived_between(cfg: dict, baseline_date: str, latest_date: str) -> list:
    found = []
    for spec in rigops_config.get(cfg, "ledger.derive_interventions", []) or []:
        spec = spec if isinstance(spec, dict) else {"repo": spec}
        repo = rigops_config.expand(spec.get("repo", ""))
        out = _git_log(repo, baseline_date, spec.get("paths") or DERIVE_GLOBS)
        for block in (out or "").split("\x1e")[1:]:
            head, _, names = block.partition("\n")
            sha, date, subject = head.split("\x1f", 2)
            if baseline_date < date <= latest_date:
                files = [n for n in names.splitlines() if n]
                found.append({"date": date, "text": subject, "repo": repo.name, "commit": sha,
                              "files": files, "derived": True})
    found.sort(key=lambda e: e["date"])
    return found


def cmd_diff(args) -> int:
    jsonl_path = state.state_dir() / "ledger.jsonl"
    rows, skipped = state.read_rows(jsonl_path, _has_date)
    _report_skipped(skipped, "ledger")
    if len(rows) < 2:
        if args.json:
            print(json.dumps({"version": 1, "skipped": skipped, "incomplete": bool(skipped),
                              "insufficient_data": False,
                              "baseline": None, "latest": None, "deltas": {},
                              "interventions": [], "derived": [],
                              "fingerprints": {"always_loaded_files": "unknown",
                                               "measurement_config": "unknown"}}, indent=2))
        else:
            print("not enough ledger rows to diff yet (need at least 2)")
        return 0

    latest = rows[-1]
    if args.since:
        try:
            since = dt.date.fromisoformat(args.since)
        except ValueError:
            print("error: --since must be YYYY-MM-DD", file=sys.stderr)
            return 2
        candidates = [r for r in rows if r.get("date", "") <= since.isoformat()]
        if not candidates:
            print(f"error: no ledger row on or before {since.isoformat()}", file=sys.stderr)
            return 2
        baseline = candidates[-1]
        if baseline.get("date") == latest.get("date"):
            print(
                "error: --since must select a baseline older than the latest row",
                file=sys.stderr,
            )
            return 2
    else:
        baseline = rows[-2]

    deltas = levers.compute_deltas(baseline, latest)
    fingerprints = ledger_row.fingerprints(baseline, latest)
    interventions, iv_skipped = _interventions_between(
        baseline.get("date", ""), latest.get("date", ""))
    _report_skipped(iv_skipped, "intervention")
    skipped += iv_skipped
    incomplete = bool(skipped)
    insufficient = ledger_row.thin(baseline) or ledger_row.thin(latest)
    if insufficient:
        deltas = {k: {**d, "pct": None} for k, d in deltas.items()}
    derived = _derived_between(rigops_config.load(), baseline.get("date", ""),
                               latest.get("date", ""))

    if args.json:
        payload = {
            "version": 1,
            "skipped": skipped,
            "incomplete": incomplete,
            "insufficient_data": insufficient,
            "baseline": baseline["date"],
            "latest": latest["date"],
            "deltas": deltas,
            "interventions": interventions,
            "derived": derived,
            "fingerprints": fingerprints,
        }
        print(json.dumps(payload, indent=2, default=str))
        return 0

    print(f"ledger diff: {baseline['date']} -> {latest['date']}"
          + ("  (incomplete: unreadable rows skipped)" if incomplete else ""))
    table_rows = [
        [
            col,
            levers.format_cell(col, d["old"]),
            levers.format_cell(col, d["new"]),
            levers.format_delta(col, d["delta"]) if d["comparable"] else "not comparable",
            "insufficient data" if insufficient else levers.format_pct(d["pct"]),
        ]
        for col, d in deltas.items()
    ]
    if insufficient:
        print(f"insufficient data: a week needs at least {ledger_row.MIN_TURNS} turns on both sides, "
              "so percentage changes are withheld")
    print(fmt.table(table_rows, ["column", "old", "new", "delta", "pct"]))
    print()
    print(f"always-loaded files: {fingerprints['always_loaded_files']}")
    print(f"measurement config: {fingerprints['measurement_config']}")
    print()
    print("Interventions in this window:")
    entries = sorted([*interventions, *derived], key=lambda e: (e.get("date", ""), "derived" in e))
    for entry in entries:
        tag = f"  [derived {entry['repo']}@{entry['commit']}]" if entry.get("derived") else ""
        print(f"{entry.get('date')}  {entry.get('text')}{_accept_suffix(entry)}{tag}")
    if not entries:
        print("none recorded")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Write a ledger row (default), note an intervention, or diff two rows."
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    write_p = sub.add_parser("write", help="append one ledger row (default)")
    write_p.add_argument("--at", help="row date YYYY-MM-DD (default today)")
    write_p.add_argument("--label", default="", help="free-text tag for the row")
    write_p.add_argument(
        "--dry-run", action="store_true", help="compute and print, write nothing"
    )
    write_p.add_argument(
        "--force", action="store_true", help="replace an existing row for that date"
    )
    write_p.add_argument("--show", action="store_true", help="print the ledger and exit, no write")
    write_p.add_argument("--json", action="store_true")

    note_p = sub.add_parser("note", help="append a free-text intervention note")
    note_p.add_argument("text", help="note text")
    note_p.add_argument("--at", help="note date YYYY-MM-DD (default today)")
    note_p.add_argument(
        "--accept", action="append", metavar="LEVER",
        help="accept the current level of a judged lever as deliberate (repeatable)",
    )

    diff_p = sub.add_parser("diff", help="week-over-week deltas with interventions between rows")
    diff_p.add_argument("--since", help="baseline = latest row on/before this date YYYY-MM-DD")
    diff_p.add_argument("--json", action="store_true")

    argv = sys.argv[1:]
    if not argv:
        argv = ["write"]
    elif argv[0] not in {"note", "diff", "write", "-h", "--help"}:
        argv = ["write", *argv]
    args = ap.parse_args(argv)

    try:
        if args.cmd == "note":
            return cmd_note(args)
        if args.cmd == "diff":
            return cmd_diff(args)
        return cmd_write(args)
    except state.MalformedJsonl as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(cli.run(main))
