#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import statistics
import sys
from collections import Counter, defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rigops import cli  # noqa: E402
from rigops import config as rigops_config  # noqa: E402
from rigops import cost  # noqa: E402
from rigops import fmt  # noqa: E402
from rigops import rebuilds  # noqa: E402
from rigops import transcripts  # noqa: E402


def group_of(path: str, groups: dict, transcripts_dir) -> str:
    rel = transcripts.relative_path(path, transcripts_dir)
    return next((name for name, sub in groups.items() if sub and sub in rel), "other")


def _cost(turns) -> dict:
    split = cost.split(turns)
    total = sum(split.values())
    return {
        "cost": total,
        "cost_pct": {k: (v / total * 100) if total else 0.0 for k, v in split.items()},
    }


def build_report(turns, by, top_n, groups=None, transcripts_dir=None) -> dict:
    n = len(turns)
    eits = [transcripts.eit(t) for t in turns]
    ctxs = [transcripts.ctx(t) for t in turns]
    total_eit = sum(eits)
    total_output = sum(t["output"] for t in turns)
    total_input = sum(t["input"] for t in turns)
    total_cache_creation = sum(t["cache_creation"] for t in turns)
    total_cache_read = sum(t["cache_read"] for t in turns)
    total_ctx = total_input + total_cache_creation + total_cache_read
    cache_hit_pct = (total_cache_read / total_ctx * 100) if total_ctx else 0.0

    ctx_sorted = sorted(ctxs)
    mean_ctx = statistics.mean(ctxs) if ctxs else 0.0
    p50 = transcripts.percentile(ctx_sorted, 0.50)
    p90 = transcripts.percentile(ctx_sorted, 0.90)
    max_ctx = max(ctxs) if ctxs else 0.0

    over_300k_eit = sum(e for e, c in zip(eits, ctxs) if c > 300_000)
    share_over_300k = (over_300k_eit / total_eit * 100) if total_eit else 0.0

    histogram = {}
    for label, lo, hi in transcripts.CTX_BUCKETS:
        bucket = [e for e, c in zip(eits, ctxs) if lo <= c < hi]
        b_eit = sum(bucket)
        histogram[label] = {
            "turns": len(bucket),
            "eit_share_pct": (b_eit / total_eit * 100) if total_eit else 0.0,
        }

    tool_counter = Counter()
    for t in turns:
        tool_counter.update(t["tools"])
    top_tools = tool_counter.most_common(10)

    group_key_fn = {
        "project": lambda t: t["project"],
        "model": lambda t: t["model"],
        "session": lambda t: t["session"],
        "group": lambda t: group_of(t["path"], groups or {}, transcripts_dir),
        "surface": lambda t: t["surface"],
        "day": lambda t: t["ts"].astimezone().date().isoformat(),
    }[by]
    group_eit = defaultdict(float)
    group_members = defaultdict(list)
    for t, e in zip(turns, eits):
        k = group_key_fn(t)
        group_eit[k] += e
        group_members[k].append(t)
    if by == "day":
        top_groups = sorted(group_eit.items())[-top_n:]
    else:
        top_groups = sorted(group_eit.items(), key=lambda kv: kv[1], reverse=True)[:top_n]
    top_groups = [
        {"key": k, "eit": v, "turns": len(group_members[k]), **_cost(group_members[k])}
        for k, v in top_groups
    ]

    return {
        "turns": n,
        "eit_total": total_eit,
        "eit_per_turn": (total_eit / n) if n else 0.0,
        "output_tokens_total": total_output,
        "cache_hit_pct": cache_hit_pct,
        "ctx_mean": mean_ctx,
        "ctx_p50": p50,
        "ctx_p90": p90,
        "ctx_max": max_ctx,
        "eit_share_over_300k_pct": share_over_300k,
        "top_tools": top_tools,
        **_cost(turns),
        "by": by,
        "top_groups": top_groups,
        "histogram": histogram,
    }


def _split_str(r) -> str:
    p = r["cost_pct"]
    return (
        f"read {p['cache_read']:.0f}% write {p['cache_write']:.0f}%"
        f" out {p['output']:.0f}% in {p['input']:.0f}%"
    )


def print_human(r) -> None:
    out = []
    out.append(f"Window: {r['window']['since']} -> {r['window']['until'] or 'now'}")
    out.append(f"Turns: {r['turns']:,}")
    out.append(f"EIT total: {r['eit_total']:,.0f}")
    out.append(f"EIT/turn: {r['eit_per_turn']:,.0f}")
    out.append(f"Output tokens total: {r['output_tokens_total']:,.0f}")
    out.append(f"Cache hit %: {r['cache_hit_pct']:.1f}")
    out.append(
        "Context mean/p50/p90/max: "
        f"{r['ctx_mean']:,.0f} / {r['ctx_p50']:,.0f} / {r['ctx_p90']:,.0f} / {r['ctx_max']:,.0f}"
    )
    out.append(f"EIT share from turns >300k ctx: {r['eit_share_over_300k_pct']:.1f}%")
    out.append(f"Cost (input-equivalent, output x5): {r['cost']:,.0f}  {_split_str(r)}")
    out.append("")
    out.append("Top tool calls:")
    for name, count in r["top_tools"]:
        out.append(f"  {name}: {count:,}")
    out.append("")
    out.append(f"Top {len(r['top_groups'])} by {r['by']} (EIT):")
    for g in r["top_groups"]:
        out.append(
            f"  {g['key']}: EIT={g['eit']:,.0f} turns={g['turns']:,}"
            f" cost={g['cost']:,.0f} ({g['cost'] / r['cost'] * 100 if r['cost'] else 0:.1f}%)"
            f"  {_split_str(g)}"
        )
    print("\n".join(out))


def print_rebuilds(summary: dict, found: list, since, top_n: int) -> None:
    head = f"cache rebuilds since {since.astimezone().date().isoformat()}: " if since else "cache rebuilds: "
    print(f"{head}{summary['count']} turns, {summary['eit_pct'] or 0:.1f}% of main-thread EIT")
    if not found:
        return
    rows = [
        [cls, str(c["count"]), f"{c['eit_pct']:.1f}%", f"{c['gap_p50_s']}s",
         str(c["model_change"]), str(c["version_change"]), str(c["shape_change"]),
         ", ".join(f"{name} {n}" for name, n in c["before"]) or "-"]
        for cls, c in summary["classes"].items()
    ]
    print(fmt.table(rows, ["class", "turns", "EIT share", "gap p50", "model chg",
                           "version chg", "shape chg", "entries before"]))
    worst = sorted(found, key=lambda h: -h["eit"])[:top_n]
    if not worst:
        return
    print(f"largest {len(worst)}:")
    print(fmt.table(
        [[h["ts"].isoformat(timespec="seconds"), h["session"][:8], h["project"], h["class"],
          f"{h['lost']:,}", f"{h['eit']:,.0f}"] for h in worst],
        ["ts", "session", "project", "class", "lost", "EIT"],
    ))


def main() -> int:
    parser = argparse.ArgumentParser(description="EIT usage report for session transcripts.")
    parser.add_argument("--since", default="-7d", help="ISO date/time, 'today', or '-Nd'")
    parser.add_argument("--until", default=None, help="ISO date/time")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--by", choices=["project", "model", "session", "group", "surface", "day"],
                        default="project",
                        help="group: ledger.watch_projects substrings, unmatched turns as other; "
                             "surface: desktop, cli or headless; day: last N local days in order")
    parser.add_argument("--top", type=int, default=10)
    parser.add_argument(
        "--rebuilds", action="store_true",
        help="main-thread turns that re-created a cached prefix, classed by cause",
    )
    parser.add_argument(
        "--dir", dest="transcripts_dir", default=None,
        help="transcripts root directory (default: config transcripts_dir)",
    )
    args = parser.parse_args(transcripts.attach_dash_values(sys.argv[1:]))

    transcripts_dir = None
    if args.transcripts_dir is not None:
        transcripts_dir = rigops_config.expand(args.transcripts_dir)
        if not transcripts_dir.is_dir():
            print(f"error: --dir not found: {transcripts_dir}", file=sys.stderr)
            return 2

    now = dt.datetime.now(dt.timezone.utc)
    since = transcripts.parse_bound(args.since, now)
    until = transcripts.parse_bound(args.until, now) if args.until else None

    if args.rebuilds:
        found, main_eit = rebuilds.collect(since, until, transcripts_dir=transcripts_dir)
        summary = rebuilds.summarize(found, main_eit)
        if args.json:
            worst = sorted(found, key=lambda h: -h["eit"])[:args.top]
            print(json.dumps({"version": 1, **summary, "largest": worst}, indent=2, default=str))
        else:
            print_rebuilds(summary, found, since, args.top)
        return 0

    turns = transcripts.collect_turns(since, until, transcripts_dir=transcripts_dir)
    groups = rigops_config.get(rigops_config.load(), "ledger.watch_projects", {}) or {}
    report = build_report(turns, args.by, args.top, groups, transcripts_dir)
    report["window"] = {
        "since": since.isoformat() if since else None,
        "until": until.isoformat() if until else None,
    }

    if args.json:
        print(json.dumps({"version": 1, **report}, indent=2, default=str))
    else:
        print_human(report)

    return 0


if __name__ == "__main__":
    sys.exit(cli.run(main))
