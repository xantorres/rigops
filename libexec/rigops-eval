#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import math
import os
import re
import sys
import urllib.parse
import uuid
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rigops import config as rigops_config  # noqa: E402
from rigops import core, fmt, state  # noqa: E402
from rigops import eval as rigops_eval  # noqa: E402

SETTINGS = (
    ("cases_dir", "cases"),
    ("system_file", "system"),
    ("endpoint", "endpoint"),
    ("model", "model"),
    ("api_key_env", "api_key_env"),
)
ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def _results_path() -> Path:
    return state.state_dir() / "eval.jsonl"


def _load_rows() -> list:
    path = _results_path()
    rows = state.read_jsonl(path)
    for row in rows:
        problem = rigops_eval.row_problem(row)
        if problem:
            raise SystemExit(f"error: malformed eval row in {path}: {problem}")
    return rows


def _pct(rate) -> str:
    return "-" if rate is None else f"{rate * 100:.1f}%"


def _ms(value) -> str:
    return "-" if value is None else str(value)


def _cells(s: dict) -> list:
    return [
        f"{s['passed']}/{s['total']}", _pct(s["pass_rate"]), _ms(s["p50_ms"]), _ms(s["p95_ms"]),
    ]


def _clean(text: str) -> str:
    # Reports carry model output and server text; a raw escape byte would drive the terminal.
    return "\n".join(rigops_eval.printable(line) for line in str(text).split("\n"))


def _table(rows: list, headers: list) -> str:
    return fmt.table([[rigops_eval.printable(str(cell)) for cell in row] for row in rows], headers)


def _fail(message: str) -> int:
    print(_clean(f"error: {message}"), file=sys.stderr)
    return 2


def _endpoint_problem(endpoint: str) -> str:
    """Refuse anything but a plain http(s) URL: credentials in it would be written
    to eval.jsonl verbatim, and urllib would not send them anyway."""
    try:
        parts = urllib.parse.urlsplit(endpoint)
        _ = parts.port
    except ValueError:
        return "endpoint is not a valid URL"
    if parts.scheme not in ("http", "https") or not parts.hostname:
        return "endpoint must be an http(s) URL with a host"
    if parts.username or parts.password or parts.query or parts.fragment:
        return "endpoint must not carry credentials, a query or a fragment; use --api-key-env"
    return ""


def _run_report(row: dict, dry_run: bool) -> str:
    head = (
        f"eval run {row['run_id']}  label={row['label'] or '-'}  model={row['model']}  "
        f"suite={row['suite']}  cases={row['totals']['total']}"
    )
    if dry_run:
        head += "  (dry-run, not recorded)"
    summaries = [*row["groups"].items(), ("total", row["totals"])]
    lines = [
        head, "", _table([[name, *_cells(s)] for name, s in summaries],
                         ["group", "pass", "rate", "p50 ms", "p95 ms"]),
    ]
    failing = [
        [result["status"], case_id, result["group"], result["reason"]]
        for case_id, result in row["cases"].items() if result["status"] != "pass"
    ]
    if failing:
        lines += ["", "not passing:", _table(failing, ["status", "case", "group", "reason"])]
    return _clean("\n".join(lines))


def cmd_run(args) -> int:
    cfg = rigops_config.load()
    settings = {}
    for key, flag in SETTINGS:
        value = getattr(args, flag)
        if value is None:
            value = core.cfg_get(cfg, f"eval.{key}", "")
            if not isinstance(value, str):
                return _fail(f"eval.{key} in config must be a string")
        settings[key] = value

    for flag, key in (("--cases", "cases_dir"), ("--endpoint", "endpoint"), ("--model", "model")):
        if not settings[key]:
            return _fail(f"no {flag[2:]}: pass {flag} or set eval.{key} in config")
    endpoint = settings["endpoint"]
    problem = _endpoint_problem(endpoint)
    if problem:
        return _fail(problem)
    api_key = None
    key_env = settings["api_key_env"]
    if key_env:
        if not ENV_NAME.fullmatch(key_env):
            return _fail("--api-key-env and eval.api_key_env take an environment variable name")
        api_key = os.environ.get(key_env)
        if not api_key:
            return _fail(f"{key_env} is not set (named by --api-key-env or eval.api_key_env)")
        if not (api_key.isascii() and api_key.isprintable()) or any(c.isspace() for c in api_key):
            return _fail(f"{key_env} holds whitespace or control characters")

    cases_path = core.expand(settings["cases_dir"])
    try:
        suite = rigops_eval.load_suite(cases_path)
    except rigops_eval.CaseError as exc:
        return _fail(f"invalid eval cases\n{exc}")

    if not math.isfinite(args.temperature) or args.temperature < 0:
        return _fail("--temperature must be a finite number, zero or more")

    system = system_hash = None
    if settings["system_file"]:
        # Not core.expand: it resolves symlinks, and read_text_file must see the link.
        system_path = rigops_config.expand(settings["system_file"])
        try:
            system = rigops_eval.read_text_file(system_path)
        except (OSError, ValueError) as exc:
            return _fail(f"cannot read system prompt {system_path}: {exc}")
        system_hash = rigops_eval.digest(system)

    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    run_id = f"{now:%Y%m%d-%H%M%S}-{uuid.uuid4().hex[:4]}"
    git_sha = core.run(["git", "-C", str(cases_path), "rev-parse", "--short", "HEAD"]).strip()

    results = {}
    total = len(suite.cases)
    for n, case in enumerate(suite.cases, start=1):
        messages = [{"role": "user", "content": case.prompt}]
        if system is not None:
            messages.insert(0, {"role": "system", "content": system})
        reply = rigops_eval.complete(
            endpoint, settings["model"], messages, max_tokens=case.max_tokens,
            temperature=args.temperature, timeout_s=case.timeout_s, api_key=api_key,
        )
        if reply["error"]:
            status, reason = "error", reply["error"]
        else:
            passed, reason = rigops_eval.evaluate(case.expect, reply["content"])
            status = "pass" if passed else "fail"
        results[case.id] = {
            "group": case.group, "status": status, "ms": reply["ms"],
            "reason": reason, "hash": case.hash,
        }
        progress = f"[{n}/{total}] {status:<5} {reply['ms']:>6} ms  {case.id}"
        print(_clean(progress), file=sys.stderr)

    row = rigops_eval.build_row(
        run_id=run_id, ts=now.isoformat(), label=args.label, endpoint=endpoint,
        model=settings["model"], temperature=args.temperature, suite=suite.hash,
        system=system_hash, git_sha=git_sha or None, cases=results,
    )
    if not args.dry_run:
        state.append_jsonl(_results_path(), row)
    print(json.dumps(row, indent=2) if args.json else _run_report(row, args.dry_run))
    return 0


def _name(meta: dict) -> str:
    return f"{meta['label']} ({meta['run_id']})" if meta.get("label") else meta["run_id"]


def _regression_line(r: dict) -> str:
    if r["metric"] == "newly_failing":
        return (
            f"REGRESSION {r['group']}: {len(r['cases'])} newly failing, "
            f"{r['base']}/{r['total']} -> {r['head']}/{r['total']} passing"
        )
    growth = f" (+{r['pct']}%)" if r["pct"] is not None else ""
    return f"REGRESSION {r['group']}: p95 {r['base']} -> {r['head']} ms{growth}"


def _diff_report(report: dict) -> str:
    base, head = report["base"], report["head"]
    meta_rows = [
        [key, base[key] or "-", head[key] or "-"] for key in ("model", "system", "suite", "git_sha")
    ]
    lines = [
        f"eval diff: {_name(base)} -> {_name(head)}",
        _table(meta_rows, ["", "base", "head"]),
        "",
        f"compared {report['shared']} unchanged cases",
    ]
    for key, what in (
        ("added", "added (no baseline)"),
        ("removed", "removed"),
        ("changed", "changed (not compared)"),
    ):
        if report[key]:
            lines.append(f"{what}: {', '.join(report[key])}")
    group_rows = [
        [
            name,
            f"{g['base']['passed']}/{g['base']['total']}",
            f"{g['head']['passed']}/{g['head']['total']}",
            _ms(g["base"]["p95_ms"]),
            _ms(g["head"]["p95_ms"]),
        ]
        for name, g in report["groups"].items()
    ]
    lines += ["", _table(group_rows, ["group", "base", "head", "p95 base", "p95 head"])]
    if report["newly_failing"]:
        failing = [
            [f["status"], f["case"], f["group"], f["reason"]] for f in report["newly_failing"]
        ]
        lines += ["", "newly failing:", _table(failing, ["status", "case", "group", "reason"])]
    if report["newly_passing"]:
        lines += ["", "newly passing: " + ", ".join(p["case"] for p in report["newly_passing"])]
    lines.append("")
    lines += [_regression_line(r) for r in report["regressions"]]
    if report["unverified"]:
        lines.append(
            f"UNVERIFIED {len(report['unverified'])} cases errored in the base run and do not "
            f"pass now: {', '.join(report['unverified'])}; re-run the baseline"
        )
    if report["dropped"]:
        lines.append(
            f"DROPPED {len(report['dropped'])} cases passed in the base run and are missing or "
            f"changed now: {', '.join(report['dropped'])}; judge the change against the base cases"
        )
    if not (report["regressions"] or report["unverified"] or report["dropped"]):
        lines.append("no regressions")
    return _clean("\n".join(lines))


def cmd_diff(args) -> int:
    tolerance = args.latency_tolerance
    if tolerance is not None and not (math.isfinite(tolerance) and tolerance >= 0):
        return _fail("--latency-tolerance must be zero or more")
    for flag, ref in (("--base", args.base), ("--head", args.head)):
        if ref is not None and not ref.strip():
            return _fail(f"{flag} must name a run id or a label")
    rows = _load_rows()
    if not rows:
        return _fail("no eval runs recorded yet")
    head = rows[-1] if args.head is None else rigops_eval.resolve(rows, args.head)
    if head is None:
        return _fail(f"no eval run matches --head {args.head}")
    if args.base is not None:
        base = rigops_eval.resolve(rows, args.base)
        if base is None:
            return _fail(f"no eval run matches --base {args.base}")
    else:
        index = next(i for i, row in enumerate(rows) if row is head)
        if index == 0:
            return _fail(f"no run before {head['run_id']} to diff against; pass --base")
        base = rows[index - 1]
    if base["run_id"] == head["run_id"]:
        return _fail("--base and --head select the same run")

    report = rigops_eval.compare(base, head, tolerance)
    if not report["shared"]:
        return _fail("the two runs share no unchanged cases, so there is nothing to compare")
    print(json.dumps(report, indent=2) if args.json else _diff_report(report))
    if report["regressions"]:
        return 1
    return 2 if report["unverified"] or report["dropped"] else 0


def cmd_list(args) -> int:
    rows = _load_rows()
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no eval runs recorded yet")
        return 0
    table_rows = [
        [
            row["run_id"],
            row.get("label") or "-",
            row.get("model") or "-",
            row.get("suite") or "-",
            *_cells(row["totals"]),
        ]
        for row in rows
    ]
    headers = ["run", "label", "model", "suite", "pass", "rate", "p50 ms", "p95 ms"]
    print(_table(table_rows, headers))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        prog="rigops-eval",
        description="Run versioned eval cases against an OpenAI-compatible endpoint, "
        "record each run, and diff two runs.",
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    run_p = sub.add_parser("run", help="run every case once and append one results row")
    run_p.add_argument("--cases", help="case directory (default: config eval.cases_dir)")
    run_p.add_argument(
        "--system", help="system prompt file sent before every case (default: eval.system_file)"
    )
    run_p.add_argument(
        "--endpoint", help="OpenAI-compatible base URL, e.g. http://127.0.0.1:1234/v1"
    )
    run_p.add_argument("--model", help="model id sent with every request")
    run_p.add_argument("--api-key-env", help="env var holding a bearer token for the endpoint")
    run_p.add_argument("--temperature", type=float, default=0.0, help="default 0")
    run_p.add_argument("--label", default="", help="tag for the run, e.g. main or proposal")
    run_p.add_argument("--dry-run", action="store_true", help="run and print, record nothing")
    run_p.add_argument("--json", action="store_true")

    diff_p = sub.add_parser("diff", help="compare two runs; exit 1 on any regression")
    diff_p.add_argument("--base", help="run id or label (default: the run before --head)")
    diff_p.add_argument("--head", help="run id or label (default: the latest run)")
    diff_p.add_argument(
        "--latency-tolerance", type=float, metavar="PCT",
        help="also fail a group whose p95 grew by more than PCT percent",
    )
    diff_p.add_argument("--json", action="store_true")

    list_p = sub.add_parser("list", help="every recorded run, oldest first")
    list_p.add_argument("--json", action="store_true")

    args = ap.parse_args(argv)
    try:
        if args.cmd == "run":
            return cmd_run(args)
        if args.cmd == "diff":
            return cmd_diff(args)
        return cmd_list(args)
    except KeyboardInterrupt:
        print("interrupted: nothing recorded", file=sys.stderr)
        return 130
    except SystemExit as exc:
        # A load error (config, results file) must not exit 1, which means regression.
        if not isinstance(exc.code, str):
            raise
        print(_clean(exc.code), file=sys.stderr)
        return 2
    except Exception as exc:  # noqa: BLE001 - exit 1 is reserved for a real regression
        return _fail(f"{type(exc).__name__}: {exc}")


if __name__ == "__main__":
    sys.exit(main())
