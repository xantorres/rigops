#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rigops import config as rigops_config  # noqa: E402

_MISSING = object()


def cmd_get(args) -> int:
    cfg = rigops_config.load()
    value = rigops_config.get(cfg, args.key, _MISSING)
    if value is _MISSING:
        return 3
    if isinstance(value, (dict, list)):
        print(json.dumps(value, separators=(",", ":"), sort_keys=True))
    else:
        print(value)
    return 0


def cmd_path(_args) -> int:
    print(rigops_config.config_path())
    return 0


def cmd_check(_args) -> int:
    path = rigops_config.config_path()
    try:
        cfg = rigops_config.load()
    except SystemExit as exc:
        print(exc, file=sys.stderr)
        return 1
    for key in cfg:
        if key not in rigops_config.DEFAULTS:
            print(f"warning: unknown top-level config key: {key}", file=sys.stderr)
    print(f"config: OK ({path})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="rigops-config")
    sub = parser.add_subparsers(dest="command", required=True)

    get_parser = sub.add_parser("get", help="print a dotted config key")
    get_parser.add_argument("key")
    get_parser.set_defaults(func=cmd_get)

    path_parser = sub.add_parser("path", help="print the resolved config file path")
    path_parser.set_defaults(func=cmd_path)

    check_parser = sub.add_parser("check", help="load config and report status")
    check_parser.set_defaults(func=cmd_check)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
