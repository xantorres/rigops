#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rigops import config as rigops_config  # noqa: E402
from rigops import fmt  # noqa: E402
from rigops import levers  # noqa: E402
from rigops import starts  # noqa: E402
from rigops import state  # noqa: E402
from rigops import transcripts  # noqa: E402


def cmd_current(cfg, as_json: bool) -> int:
    paths_cfg = rigops_config.get(cfg, "fixed_tax.paths", []) or []
    globs_cfg = rigops_config.get(cfg, "fixed_tax.globs", []) or []
    if not paths_cfg and not globs_cfg:
        if as_json:
            print(json.dumps({"files": [], "total_bytes": 0}, indent=2))
        else:
            print("fixed_tax not configured (fixed_tax.paths and fixed_tax.globs both empty)")
        return 0

    entries = levers.fixed_tax_entries(cfg)
    if not entries:
        if as_json:
            print(json.dumps({"files": [], "total_bytes": 0}, indent=2))
        else:
            print("fixed_tax configured but no matching files found")
        return 0

    entries = sorted(entries, key=lambda e: e[1], reverse=True)
    total = sum(size for _, size in entries)

    if as_json:
        payload = {
            "files": [{"path": str(p), "bytes": size} for p, size in entries],
            "total_bytes": total,
        }
        print(json.dumps(payload, indent=2))
        return 0

    rows = [[str(p), fmt.human_bytes(size)] for p, size in entries]
    print(fmt.table(rows, ["file", "size"]))
    print(f"total: {fmt.human_bytes(total)}")
    return 0


def cmd_history(as_json: bool) -> int:
    jsonl_path = state.state_dir() / "ledger.jsonl"
    rows = state.read_jsonl(jsonl_path)
    if not rows:
        print("[]" if as_json else "no ledger rows yet")
        return 0

    series = [(r.get("date"), r.get("fixed_tax_b")) for r in rows]

    if as_json:
        print(json.dumps([{"date": d, "fixed_tax_b": v} for d, v in series], indent=2))
        return 0

    print(fmt.sparkline(v for _, v in series))
    non_none = [(d, v) for d, v in series if v is not None]
    if not non_none:
        print("no fixed_tax_b data in ledger")
        return 0
    first_date, first_val = non_none[0]
    last_date, last_val = non_none[-1]
    delta = last_val - first_val
    print(f"first {first_date}: {fmt.human_bytes(first_val)}")
    print(f"last  {last_date}: {fmt.human_bytes(last_val)}")
    if first_val:
        print(f"delta: {delta:+d} B ({delta / first_val * 100:+.1f}%)")
    else:
        print(f"delta: {delta:+d} B")
    return 0


def _k(chars) -> str:
    return f"{chars / 1000:.1f}k"


def _print_session(start: dict, top: int) -> None:
    print(
        f"{start['session']}  {start['ts'].isoformat()}  {start['surface']}  "
        f"project {start['project']}"
    )
    print(
        f"tools {start['tools']}, tool schemas {_k(start['tool_chars'])} chars, "
        f"system {_k(start['system_chars'])} chars"
    )
    groups = sorted(start["groups"].items(), key=lambda kv: (-kv[1]["chars"], kv[0]))
    print(fmt.table(
        [[g, str(v["tools"]), _k(v["chars"])] for g, v in groups], ["group", "tools", "chars"],
    ))
    largest = sorted(start["tool_sizes"].items(), key=lambda kv: (-kv[1], kv[0]))[:top]
    print(f"largest {len(largest)} tools:")
    print(fmt.table([[n, _k(c)] for n, c in largest], ["tool", "chars"]))


def _jsonable(start: dict) -> dict:
    return {**start, "ts": start["ts"].isoformat()}


def cmd_starts(args) -> int:
    now = dt.datetime.now(dt.timezone.utc)
    since_raw = args.since or (None if args.session else "-7d")
    since = transcripts.parse_bound(since_raw, now)
    until = transcripts.parse_bound(args.until, now) if args.until else None
    tdir = rigops_config.expand(args.transcripts_dir) if args.transcripts_dir else None
    found = starts.collect_starts(
        since, until, transcripts_dir=tdir, subagents=args.subagents, session=args.session,
    )
    if args.session:
        if not found:
            print(f"no session start matching {args.session} in the window", file=sys.stderr)
            return 1
        if args.json:
            print(json.dumps([_jsonable(s) for s in found], indent=2))
            return 0
        for i, start in enumerate(found):
            if i:
                print()
            _print_session(start, args.top)
        return 0
    summary = starts.summarize(found)
    if args.json:
        print(json.dumps(summary, indent=2))
        return 0
    if not found:
        print("no session starts with a recorded request shape in the window")
        return 0
    print(f"session starts since {since.astimezone().date().isoformat()}: {summary['starts']}")
    print(fmt.table(
        [
            [name, str(v["starts"]), f"{v['tools_p50']:g}", _k(v["tool_chars_p50"]),
             _k(v["system_chars_p50"])]
            for name, v in summary["surfaces"].items()
        ],
        ["surface", "starts", "tools p50", "tool chars p50", "system chars p50"],
    ))
    print("tool groups, ranked by chars x starts:")
    print(fmt.table(
        [[g["group"], str(g["starts"]), _k(g["chars_p50"])] for g in summary["groups"][:args.top]],
        ["group", "starts", "chars p50"],
    ))
    return 0


def cmd_dead(args) -> int:
    now = dt.datetime.now(dt.timezone.utc)
    since = transcripts.parse_bound(args.since or "-30d", now)
    until = transcripts.parse_bound(args.until, now) if args.until else None
    tdir = rigops_config.expand(args.transcripts_dir) if args.transcripts_dir else None
    found = starts.collect_starts(since, until, transcripts_dir=tdir, subagents=args.subagents)
    calls = starts.count_calls(since, until, transcripts_dir=tdir)
    report = starts.dead_weight(found, calls, args.max_per_100)
    if args.json:
        print(json.dumps(report, indent=2))
        return 0
    if not found:
        print("no session starts with a recorded request shape in the window")
        return 0
    print(
        f"session starts since {since.astimezone().date().isoformat()}: {report['starts']}; "
        f"loaded but called at most {args.max_per_100:g} times per 100 loads:"
    )
    head = ["sessions", "calls", "chars p50", "carried"]

    def cells(r):
        return [str(r["sessions"]), str(r["calls"]), _k(r["chars_p50"]), _k(r["carried"])]

    groups = report["groups"][:args.top]
    print(fmt.table([[g["name"], str(g["tools"]), *cells(g)] for g in groups],
                    ["group", "tools", *head]) if groups else "groups: none")
    tools = report["tools"][:args.top]
    print(fmt.table([[t["name"], *cells(t)] for t in tools], ["tool", *head])
          if tools else "tools: none")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Fixed context tax: always-loaded config bytes.")
    ap.add_argument("--history", action="store_true", help="fixed_tax_b trend across the ledger")
    ap.add_argument(
        "--starts", action="store_true",
        help="what session starts load: tool schemas and system prompt, per surface",
    )
    ap.add_argument(
        "--dead", action="store_true",
        help="tools and tool groups loaded at session start but rarely or never called",
    )
    ap.add_argument(
        "--max-per-100", type=float, default=1.0,
        help="with --dead: most calls per 100 loading sessions still counted as dead (default 1)",
    )
    ap.add_argument(
        "--since", default=None,
        help="ISO date, 'today' or '-Nd' (--starts default -7d, unbounded with --session; "
             "--dead default -30d)",
    )
    ap.add_argument("--until", default=None, help="with --starts or --dead: ISO date")
    ap.add_argument("--session", default=None, help="with --starts: one session id (prefix)")
    ap.add_argument("--subagents", action="store_true", help="with --starts: count subagents too")
    ap.add_argument("--top", type=int, default=15, help="rows per ranked table")
    ap.add_argument("--dir", dest="transcripts_dir", default=None, help="transcripts root")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(transcripts.attach_dash_values(sys.argv[1:]))

    if args.transcripts_dir is not None:
        resolved = rigops_config.expand(args.transcripts_dir)
        if not resolved.is_dir():
            print(f"error: --dir not found: {resolved}", file=sys.stderr)
            return 2

    cfg = rigops_config.load()
    if args.dead:
        return cmd_dead(args)
    if args.starts:
        return cmd_starts(args)
    if args.history:
        return cmd_history(args.json)
    return cmd_current(cfg, args.json)


if __name__ == "__main__":
    sys.exit(main())
