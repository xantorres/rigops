#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rigops import config as rigops_config  # noqa: E402
from rigops import fmt  # noqa: E402
from rigops import levers  # noqa: E402
from rigops import state  # noqa: E402


def cmd_current(cfg, as_json: bool) -> int:
    paths_cfg = rigops_config.get(cfg, "fixed_tax.paths", []) or []
    globs_cfg = rigops_config.get(cfg, "fixed_tax.globs", []) or []
    if not paths_cfg and not globs_cfg:
        print("fixed_tax not configured (fixed_tax.paths and fixed_tax.globs both empty)")
        return 0

    entries = levers.fixed_tax_entries(cfg)
    if not entries:
        print("fixed_tax configured but no matching files found")
        return 0

    entries = sorted(entries, key=lambda e: e[1], reverse=True)
    total = sum(size for _, size in entries)

    if as_json:
        payload = {
            "files": [{"path": str(p), "bytes": size} for p, size in entries],
            "total_bytes": total,
        }
        print(json.dumps(payload, indent=2))
        return 0

    rows = [[str(p), fmt.human_bytes(size)] for p, size in entries]
    print(fmt.table(rows, ["file", "size"]))
    print(f"total: {fmt.human_bytes(total)}")
    return 0


def cmd_history(as_json: bool) -> int:
    jsonl_path = state.state_dir() / "ledger.jsonl"
    rows = state.read_jsonl(jsonl_path)
    if not rows:
        print("no ledger rows yet")
        return 0

    series = [(r.get("date"), r.get("fixed_tax_b")) for r in rows]

    if as_json:
        print(json.dumps([{"date": d, "fixed_tax_b": v} for d, v in series], indent=2))
        return 0

    print(fmt.sparkline(v for _, v in series))
    non_none = [(d, v) for d, v in series if v is not None]
    if not non_none:
        print("no fixed_tax_b data in ledger")
        return 0
    first_date, first_val = non_none[0]
    last_date, last_val = non_none[-1]
    delta = last_val - first_val
    print(f"first {first_date}: {fmt.human_bytes(first_val)}")
    print(f"last  {last_date}: {fmt.human_bytes(last_val)}")
    if first_val:
        print(f"delta: {delta:+d} B ({delta / first_val * 100:+.1f}%)")
    else:
        print(f"delta: {delta:+d} B")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="Fixed context tax: always-loaded config bytes.")
    ap.add_argument("--history", action="store_true", help="fixed_tax_b trend across the ledger")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    cfg = rigops_config.load()
    if args.history:
        return cmd_history(args.json)
    return cmd_current(cfg, args.json)


if __name__ == "__main__":
    sys.exit(main())
