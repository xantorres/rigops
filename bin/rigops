#!/bin/sh
set -eu

resolve_dir() {
    target="$1"
    while [ -L "$target" ]; do
        link="$(readlink "$target")"
        case "$link" in
            /*) target="$link" ;;
            *) target="$(dirname "$target")/$link" ;;
        esac
    done
    cd -P "$(dirname "$target")" && pwd
}

BIN_DIR="$(resolve_dir "$0")"
ROOT_DIR="$(cd -P "$BIN_DIR/.." && pwd)"
CLI_DIR="$ROOT_DIR/lib/rigops/cli"

list_commands() {
    for f in "$CLI_DIR"/*.py; do
        [ -e "$f" ] || continue
        basename "$f" .py
    done | grep -vx -e hook -e __init__
}

usage() {
    echo "usage: rigops <command> [args...]"
    echo ""
    echo "commands:"
    list_commands | sed 's/^/  /'
}

if [ "$#" -eq 0 ]; then
    usage
    exit 0
fi

cmd="$1"
shift

case "$cmd" in
    help|--help)
        usage
        exit 0
        ;;
    --version)
        cmd=version
        ;;
esac

if [ ! -f "$CLI_DIR/$cmd.py" ] || [ "$cmd" = __init__ ]; then
    echo "error: unknown command '$cmd'" >&2
    echo "" >&2
    usage >&2
    exit 2
fi

PYTHONPATH="$ROOT_DIR/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m "rigops.cli.$cmd" "$@"
